{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/", "/municipio/ba/salvador", "/calculadora", "/mapa", "/perguntas"],
      "settings": { "formFactor": "mobile", "chromeFlags": "--no-sandbox --headless=new" },
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    }
  }
}

---
import Base from "../layouts/Base.astro";
import StaticMap from "../components/StaticMap.astro";
import { DEFAULT_UF, indicators, resumo, ufs } from "../lib/data";
import { THERMO_COLORS } from "../lib/indicators";

const IND = indicators();
const layers = [
  { id: "prioridade", label: "Ranking de prioridade (posição)", kind: "cat" },
  ...Object.entries(IND).filter(([, d]) => d.map).map(([k, d]) => ({ id: k, label: d.short, kind: "ind" })),
  { id: "thermo_agua", label: "Meta 2033: água", kind: "thermo" },
  { id: "thermo_esgoto", label: "Meta 2033: esgoto coletado e tratado", kind: "thermo" },
  { id: "semiarido", label: "Semiárido", kind: "cat" },
  { id: "sdw", label: "Onde o Instituto SDW atua", kind: "cat" },
];
const list = ufs();
const R0 = resumo(DEFAULT_UF);
const preview = Object.fromEntries(R0.municipios.map((m) => [m.cod, THERMO_COLORS[m.thermo.esgoto]]));
// Camadas sem nenhum valor na UF padrão ficam desabilitadas e rotuladas (revisão M4)
const hasData = (id: string) => (id === "prioridade" ? R0.municipios.some((m) => m.rank != null) : false) || id.startsWith("thermo") || id === "semiarido" || id === "sdw" || R0.municipios.some((m) => (id === "indice_prioridade" ? m.idx : m.ind[id]) != null);
---
<Base title="Mapa" description="Mapa interativo de água, esgoto, saúde e comunidades de cada município.">
  <link rel="preload" as="fetch" href="/data/ba/resumo.json" crossorigin="anonymous" slot="head" />
  <section class="wrap mapwrap">
    <div class="side">
      <h1>Mapa</h1>
      <div class="field">
        <label for="uf">Estado</label>
        <select id="uf">{list.map((u) => <option value={u.slug} selected={u.slug === DEFAULT_UF}>{u.name}</option>)}</select>
      </div>
      <div class="field">
        <label for="layer">O que mostrar</label>
        <select id="layer">{layers.map((l) => <option value={l.id} selected={l.id === "thermo_esgoto"} disabled={!hasData(l.id)}>{l.label}{!hasData(l.id) && " (sem dado nesta versão)"}</option>)}</select>
      </div>
      <fieldset class="field">
        <legend>Camadas de território</legend>
        <label class="check"><input type="checkbox" id="tis" /> Terras indígenas (FUNAI)</label>
        <label class="check"><input type="checkbox" id="ucs" /> Reservas extrativistas e RDS (MMA)</label>
        <label class="check"><input type="checkbox" id="basemap" /> Mapa de fundo (usa mais dados)</label>
      </fieldset>
      <div id="legend" class="legend" aria-live="polite"></div>
      <p class="small"><a href="#tabela" id="to-table">Ver estes dados em tabela</a></p>
      <p id="desc" class="small"></p>
      <p id="source" class="source"></p>
      <p class="xsmall muted">Territórios quilombolas (INCRA) e assentamentos ainda não estão integrados. <a href="/dados#fontes">Ver o estado das fontes</a>.</p>
    </div>
    <div class="mapbox">
      <div id="map" role="region" aria-label="Mapa interativo. A mesma informação está na tabela abaixo do mapa.">
        <div id="preview" class="preview">
          <StaticMap uf={DEFAULT_UF} values={{}} palette={[]} categorical={preview} label="Prévia estática do mapa: meta de esgoto de 2033" />
          <button type="button" class="btn" id="activate">Abrir mapa interativo</button>
        </div>
      </div>
      <div id="tip" class="tip" hidden></div>
      <noscript><p class="card">O mapa interativo precisa de JavaScript. A tabela abaixo traz os mesmos dados.</p></noscript>
    </div>
  </section>
  <section class="wrap section">
    <details class="tabled" id="tabela">
    <summary><span id="table-title">Tabela do mapa</span> <span class="small muted">(todos os municípios, mesma informação do mapa)</span></summary>
    <p class="small">Clique no título de uma coluna para ordenar.</p>
    <div class="table-scroll card flat" tabindex="0" role="region" aria-label="Tabela do mapa"><table id="tbl"><caption class="visually-hidden" id="tbl-cap"></caption><thead><tr><th scope="col"><button data-sort="nome">Município</button></th><th scope="col" class="num"><button data-sort="v">Valor</button></th><th scope="col">Região intermediária</th></tr></thead><tbody></tbody></table></div>
    </details>
  </section>
</Base>
<script>
  import type * as ML from "maplibre-gl";
  import { classOf, fmtValue, GOOD, BAD, NODATA, PRIO_CLASSES, prioClass, quantileBreaks, THERMO_COLORS, THERMO_LABEL, unitLabel } from "../lib/indicators";
  import { fmtNumber } from "../lib/format";
  import type { IndicatorDef, Resumo } from "../lib/types";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const ufSel = $<HTMLSelectElement>("uf"), layerSel = $<HTMLSelectElement>("layer");
  const qs = new URLSearchParams(location.search);
  if (qs.get("uf")) ufSel.value = qs.get("uf")!;
  if (qs.get("c")) layerSel.value = qs.get("c")!;
  let IND: Record<string, IndicatorDef> = {};
  let R: Resumo;
  let geo: any;
  let sortKey = "v", sortDir = -1, lastLayer = "";

  // O MapLibre (~300 KB comprimido) só carrega sob demanda: botão no celular, ociosidade no desktop.
  let maplibregl: typeof ML;
  let map: ML.Map;
  let mapReady = false;

  function valueOf(m: Resumo["municipios"][number], layer: string): number | string | null {
    if (layer === "thermo_agua") return m.thermo.agua;
    if (layer === "thermo_esgoto") return m.thermo.esgoto;
    if (layer === "semiarido") return m.semiarido === null ? null : m.semiarido ? "sim" : "nao";
    if (layer === "sdw") return m.sdw ? "sim" : "nao";
    if (layer === "indice_prioridade") return m.idx;
    if (layer === "prioridade") return m.rank;
    return m.ind[layer] ?? null;
  }

  const nRanked = () => R.municipios.filter((m) => m.rank != null).length;

  function scale(layer: string) {
    const vals = R.municipios.map((m) => valueOf(m, layer));
    if (layer.startsWith("thermo")) return { color: (v: any) => THERMO_COLORS[v] ?? NODATA, legend: Object.keys(THERMO_LABEL).map((k) => ({ c: THERMO_COLORS[k], t: `${THERMO_LABEL[k]} (${vals.filter((v) => v === k).length})` })) };
    if (layer === "semiarido") return { color: (v: any) => (v === "sim" ? "#c8873a" : v === "nao" ? "#e8e1d4" : NODATA), legend: [{ c: "#c8873a", t: "No Semiárido" }, { c: "#e8e1d4", t: "Fora do Semiárido" }] };
    if (layer === "prioridade") {
      const n = nRanked();
      const legend: { c: string; t: string }[] = PRIO_CLASSES.map((c) => ({ c: c.color as string, t: `${c.label}: ${vals.filter((v) => prioClass(v as number | null, n)?.key === c.key).length}` }));
      legend.push({ c: NODATA, t: `Fora do ranking por falta de dados: ${vals.filter((v) => v === null).length}` });
      return { color: (v: any) => prioClass(v, n)?.color ?? NODATA, legend };
    }
    if (layer === "sdw") return { color: (v: any) => (v === "sim" ? "#0e5c7d" : "#e8e1d4"), legend: [{ c: "#0e5c7d", t: "Município com atuação do Instituto SDW" }, { c: "#e8e1d4", t: "Outros municípios" }] };
    const def = IND[layer];
    const pal = def.direction === "higher_is_better" ? GOOD : BAD;
    if (!vals.some((v) => v !== null)) return { color: () => NODATA, legend: [{ c: NODATA, t: "Sem dado nesta versão para nenhum município" }] };
    const br = quantileBreaks(vals as (number | null)[], pal.length);
    const color = (v: any) => { const c = classOf(v, br); return c === null ? NODATA : pal[Math.min(c, pal.length - 1)]; };
    const edges = [Math.min(...(vals.filter((v) => v !== null) as number[])), ...br, Math.max(...(vals.filter((v) => v !== null) as number[]))];
    const legend = pal.slice(0, br.length + 1).map((c, i) => ({ c, t: `${fmtValue(def, edges[i])} a ${fmtValue(def, edges[i + 1])}` }));
    legend.push({ c: NODATA, t: `Sem dado (${vals.filter((v) => v === null).length})` });
    return { color, legend };
  }

  function paint() {
    const layer = layerSel.value;
    // No ranking, a tabela abre do 1º ao último; nos indicadores, do maior para o menor
    if (layer !== lastLayer && sortKey === "v") sortDir = layer === "prioridade" ? 1 : -1;
    lastLayer = layer;
    const s = scale(layer);
    const byCod = new Map(R.municipios.map((m) => [m.cod, m]));
    for (const f of geo?.features ?? []) {
      const m = byCod.get(String(f.properties.cod_ibge7));
      f.properties.fill = m ? s.color(valueOf(m, layer)) : NODATA;
    }
    if (mapReady && map?.getSource("mun")) (map.getSource("mun") as ML.GeoJSONSource).setData(geo);
    const def = IND[layer];
    $("legend").innerHTML = `<p class="small"><strong>${layerSel.selectedOptions[0].text}</strong>${def ? ` <span class="muted">(${unitLabel(def)})</span>` : ""}</p><ul>${s.legend.map((l) => `<li><i style="background:${l.c}"></i>${l.t}</li>`).join("")}</ul>`;
    const srcKey = def?.source === "snis" || layer.startsWith("thermo") ? "snis" : def?.source === "datasus_sih" ? "sih_drsai" : layer === "semiarido" ? "semiarido" : def?.source === "ibge_censo2022" ? "censo_lixo" : null;
    const src = srcKey ? R.sources[srcKey] : null;
    $("desc").textContent = def ? def.formula : layer === "prioridade" ? `Posição de cada município no ranking de prioridade do estado (1º = onde o investimento em saneamento gera mais impacto), com os pesos padrão.${R.index.provisional ? ` Ranking provisório: ainda sem a dimensão ${(R.index.provisional_without ?? []).map((d) => R.index.dimensions[d].label.toLowerCase()).join(" e ")}.` : ""} Para mudar os pesos, use a página Prioridades.` : layer.startsWith("thermo") ? "Situação de cada município em relação à meta de 2033 do Marco Legal do Saneamento, pela tendência do SNIS." : layer === "sdw" ? "Municípios onde o Instituto SDW tem sede ou projetos (informação do próprio Instituto)." : "Delimitação oficial do Semiárido (Sudene).";
    $("source").textContent = src ? `Fonte: ${src.name}, ${src.reference_period ?? ""}${src.status === "unavailable" ? " (indisponível nesta atualização)" : ""}${src.url_kind === "mirror" ? " (cópia pública do dado oficial)" : ""}` : "";
    renderTable();
    history.replaceState(null, "", `?uf=${ufSel.value}&c=${layer}`);
  }

  function display(m: Resumo["municipios"][number], layer: string) {
    const v = valueOf(m, layer);
    if (layer.startsWith("thermo")) return THERMO_LABEL[v as string] ?? "sem dado";
    if (layer === "semiarido" || layer === "sdw") return v === "sim" ? "Sim" : v === "nao" ? "Não" : "sem dado";
    if (layer === "prioridade") { const n = nRanked(); const c = prioClass(v as number | null, n); return v === null ? "fora do ranking" : `${v}º de ${n} · ${c?.short ?? ""}`; }
    return fmtValue(IND[layer], v as number | null);
  }

  function renderTable() {
    const layer = layerSel.value;
    const rows = [...R.municipios].sort((a, b) => {
      if (sortKey === "nome") return a.nome.localeCompare(b.nome, "pt-BR") * sortDir;
      const va = valueOf(a, layer), vb = valueOf(b, layer);
      if (va === null) return 1; if (vb === null) return -1;
      return (typeof va === "number" ? (va as number) - (vb as number) : String(va).localeCompare(String(vb))) * sortDir;
    });
    $("tbl-cap").textContent = `${layerSel.selectedOptions[0].text} por município, ${R.uf.nome}`;
    $("table-title").textContent = `Tabela do mapa: ${layerSel.selectedOptions[0].text}`;
    document.querySelectorAll<HTMLButtonElement>("#tbl th button").forEach((b) => b.parentElement!.setAttribute("aria-sort", b.dataset.sort === sortKey ? (sortDir > 0 ? "ascending" : "descending") : "none"));
    $("tbl").querySelector("tbody")!.innerHTML = rows.map((m) => `<tr><th scope="row"><a href="/municipio/${R.uf.slug}/${m.slug}">${m.nome}</a></th><td class="num">${display(m, layer)}</td><td>${m.ri ?? ""}</td></tr>`).join("");
  }

  async function loadUF() {
    const uf = ufSel.value;
    const [r, ind] = await Promise.all([
      fetch(`/data/${uf}/resumo.json`).then((x) => x.json()),
      Object.keys(IND).length ? Promise.resolve(IND) : fetch(`/data/indicadores.json`).then((x) => x.json()),
    ]);
    R = r; IND = ind;
    geo = null;
    paint();
    // O mapa pode estar carregando (mapReady já verdadeiro, mas `map` ainda não criado): nesse caso, o initMap
    // desenha o estado escolhido ao terminar. Antes, trocar de estado nesse intervalo dava erro de JavaScript.
    if (mapReady && map) await addToMap();
  }

  async function addToMap() {
    // A malha (~120 KB) só é baixada quando o mapa interativo é aberto (economia de dados no 3G).
    if (!geo) { geo = await fetch(`/data/${ufSel.value}/mapa.geojson`).then((x) => x.json()); paint(); }
    const add = () => {
      if (map.getSource("mun")) (map.getSource("mun") as ML.GeoJSONSource).setData(geo);
      else {
        map.addSource("mun", { type: "geojson", data: geo });
        map.addLayer({ id: "mun-fill", type: "fill", source: "mun", paint: { "fill-color": ["get", "fill"], "fill-opacity": 0.92 } });
        map.addLayer({ id: "mun-line", type: "line", source: "mun", paint: { "line-color": "#ffffff", "line-width": 0.5 } });
        map.addLayer({ id: "mun-hover", type: "line", source: "mun", paint: { "line-color": "#13212c", "line-width": 2.5 }, filter: ["==", ["get", "cod_ibge7"], ""] });
      }
      const b = new maplibregl.LngLatBounds();
      for (const f of geo.features) for (const poly of f.geometry.type === "Polygon" ? [f.geometry.coordinates] : f.geometry.coordinates) for (const [x, y] of poly[0]) b.extend([x, y]);
      map.fitBounds(b, { padding: 20, animate: false });
    };
    map.loaded() ? add() : map.once("load", add);
  }

  async function initMap() {
    if (mapReady) return;
    mapReady = true;
    $("activate").setAttribute("disabled", "");
    $("activate").textContent = "Carregando mapa…";
    const [mod] = await Promise.all([import("maplibre-gl"), import("maplibre-gl/dist/maplibre-gl.css")]);
    maplibregl = mod;
    maplibregl.setWorkerUrl("/vendor/maplibre-gl-worker.mjs");
    $("preview").remove();
    map = new maplibregl.Map({
      container: "map", style: { version: 8, sources: {}, layers: [{ id: "bg", type: "background", paint: { "background-color": "#eef4f6" } }] },
      center: [-41.7, -12.9], zoom: 5, attributionControl: { compact: true }, cooperativeGestures: true,
      locale: {
        "NavigationControl.ZoomIn": "Aproximar", "NavigationControl.ZoomOut": "Afastar", "Map.Title": "Mapa dos municípios",
        "CooperativeGesturesHandler.WindowsHelpText": "Use Ctrl + rolagem para aproximar o mapa",
        "CooperativeGesturesHandler.MacHelpText": "Use ⌘ + rolagem para aproximar o mapa",
        "CooperativeGesturesHandler.MobileHelpText": "Use dois dedos para mover o mapa",
      },
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
    const tip = $("tip");
    map.on("mousemove", "mun-fill", (e: ML.MapLayerMouseEvent) => {
      const f = e.features?.[0]; if (!f) return;
      const m = R.municipios.find((x) => x.cod === String(f.properties!.cod_ibge7)); if (!m) return;
      map.setFilter("mun-hover", ["==", ["get", "cod_ibge7"], f.properties!.cod_ibge7]);
      map.getCanvas().style.cursor = "pointer";
      tip.hidden = false;
      tip.innerHTML = `<strong>${m.nome}</strong><br>${layerSel.selectedOptions[0].text}: ${display(m, layerSel.value)}<br><span class="xsmall">${$("source").textContent}</span><br><span class="xsmall">Clique para abrir a ficha</span>`;
      tip.style.left = `${e.point.x + 12}px`; tip.style.top = `${e.point.y + 12}px`;
    });
    map.on("mouseleave", "mun-fill", () => { tip.hidden = true; map.getCanvas().style.cursor = ""; map.setFilter("mun-hover", ["==", ["get", "cod_ibge7"], ""]); });
    map.on("click", "mun-fill", (e: ML.MapLayerMouseEvent) => { const f = e.features?.[0]; const m = f && R.municipios.find((x) => x.cod === String(f.properties!.cod_ibge7)); if (m) location.href = `/municipio/${R.uf.slug}/${m.slug}`; });
    map.on("click", "tis-fill", (e: ML.MapLayerMouseEvent) => {
      const p = e.features?.[0]?.properties; if (!p) return;
      new maplibregl.Popup().setLngLat(e.lngLat).setHTML(`<strong>Terra Indígena ${p.nome}</strong><br>Situação: ${p.fase ?? "não informada"}<br><span style="font-size:12px">Fonte: FUNAI (limites simplificados)</span>`).addTo(map);
    });
    BLANK = map.getStyle();
    if (R) await addToMap();
    if (($("tis") as HTMLInputElement).checked) toggleTis(true);
  }

  function toggleTis(on: boolean) {
    if (!mapReady || !map) return;
    const run = () => {
      if (on && !map.getSource("tis")) {
        map.addSource("tis", { type: "geojson", data: `/data/${ufSel.value}/terras_indigenas.geojson` });
        map.addLayer({ id: "tis-fill", type: "fill", source: "tis", paint: { "fill-color": "#5b2a86", "fill-opacity": 0.25 } });
        map.addLayer({ id: "tis-line", type: "line", source: "tis", paint: { "line-color": "#5b2a86", "line-width": 1.5, "line-dasharray": [2, 1] } });
      }
      for (const id of ["tis-fill", "tis-line"]) if (map.getLayer(id)) map.setLayoutProperty(id, "visibility", on ? "visible" : "none");
    };
    map.loaded() ? run() : map.once("load", run);
  }
  function toggleUcs(on: boolean) {
    if (!mapReady || !map) return;
    const run = () => {
      if (on && !map.getSource("ucs")) {
        map.addSource("ucs", { type: "geojson", data: `/data/${ufSel.value}/ucs_uso_sustentavel.geojson` });
        map.addLayer({ id: "ucs-fill", type: "fill", source: "ucs", paint: { "fill-color": "#2e7d32", "fill-opacity": 0.25 } });
        map.addLayer({ id: "ucs-line", type: "line", source: "ucs", paint: { "line-color": "#1b5e20", "line-width": 1.5 } });
        map.on("click", "ucs-fill", (e: ML.MapLayerMouseEvent) => {
          const p = e.features?.[0]?.properties; if (!p) return;
          new maplibregl.Popup().setLngLat(e.lngLat).setHTML(`<strong>${p.nome}</strong><br>${p.categoria}<br><span style="font-size:12px">Fonte: CNUC/MMA</span>`).addTo(map);
        });
      }
      for (const id of ["ucs-fill", "ucs-line"]) if (map.getLayer(id)) map.setLayoutProperty(id, "visibility", on ? "visible" : "none");
    };
    map.loaded() ? run() : map.once("load", run);
  }
  $("ucs").addEventListener("change", async (e) => {
    const on = (e.target as HTMLInputElement).checked;
    if (on && !mapReady) await initMap();
    toggleUcs(on);
  });
  $("tis").addEventListener("change", async (e) => {
    const on = (e.target as HTMLInputElement).checked;
    if (on && !mapReady) await initMap();
    toggleTis(on);
  });

  // Mapa de fundo opcional: estilo vetorial gratuito e sem chave do OpenFreeMap (SPEC §4). Desligado por padrão
  // para economizar dados em 3G. Nossas camadas são preservadas na troca de estilo.
  let BLANK: ML.StyleSpecification;
  $("basemap").addEventListener("change", async (e) => {
    const on = (e.target as HTMLInputElement).checked;
    if (!mapReady) await initMap();
    const keep = (prev: ML.StyleSpecification, next: ML.StyleSpecification): ML.StyleSpecification => ({
      ...next,
      sources: { ...next.sources, ...Object.fromEntries(Object.entries(prev.sources).filter(([k]) => ["mun", "tis", "ucs"].includes(k))) },
      layers: [...next.layers.filter((l) => l.id !== "bg"), ...prev.layers.filter((l) => /^(mun|tis|ucs)/.test(l.id))],
    });
    map.setStyle(on ? "https://tiles.openfreemap.org/styles/positron" : BLANK, { transformStyle: (prev, next) => (prev ? keep(prev, next) : next) });
    map.once("styledata", () => { if (map.getLayer("mun-fill")) map.setPaintProperty("mun-fill", "fill-opacity", on ? 0.72 : 0.92); });
  });
  document.querySelectorAll<HTMLButtonElement>("#tbl th button").forEach((b) => b.addEventListener("click", () => {
    if (sortKey === b.dataset.sort) sortDir *= -1; else { sortKey = b.dataset.sort!; sortDir = sortKey === "nome" ? 1 : -1; }
    renderTable();
  }));
  layerSel.addEventListener("change", () => { paint(); if (!mapReady) $("preview").classList.add("stale"); });
  ufSel.addEventListener("change", () => { loadUF(); if (!mapReady) initMap(); });
  $("activate").addEventListener("click", initMap);
  $("to-table").addEventListener("click", () => { ($("tabela") as HTMLDetailsElement).open = true; });
  loadUF();
  // Desktop com boa conexão: ativa sozinho quando o navegador fica ocioso. Celular ou economia de dados: espera o botão.
  const conn = (navigator as any).connection;
  const saveData = conn?.saveData || /2g|3g/.test(conn?.effectiveType ?? "");
  if (matchMedia("(min-width: 900px) and (pointer: fine)").matches && !saveData) {
    const idle = (window as any).requestIdleCallback ?? ((f: () => void) => setTimeout(f, 1500));
    window.addEventListener("load", () => idle(() => initMap(), { timeout: 4000 }));
  }
</script>
<style>
  /* minmax(0, 1fr): sem isso, a opção mais longa do seletor alargava a coluna e criava rolagem lateral no celular */
  .mapwrap { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); padding-top: var(--s-5); }
  @media (min-width: 900px) { .mapwrap { grid-template-columns: 20rem 1fr; } }
  .side { display: grid; gap: var(--s-3); align-content: start; min-width: 0; }
  .field { border: 0; padding: 0; margin: 0; display: grid; gap: var(--s-1); }
  .field label, .field legend { font-weight: 700; }
  select { padding: 0.6rem; border: 1px solid var(--c-ink-muted); border-radius: 8px; min-height: 44px; background: #fff; width: 100%; }
  .check { font-weight: 400 !important; display: flex; gap: var(--s-2); align-items: center; min-height: 32px; }
  .check input { width: 20px; height: 20px; }
  .mapbox { position: relative; }
  #map { height: min(72vh, 680px); min-height: 380px; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--c-line); }
  .preview { position: relative; height: 100%; display: grid; place-items: center; padding: var(--s-4); background: #eef4f6; }
  .preview :global(svg) { max-height: 100%; width: auto; max-width: 100%; }
  .preview #activate { position: absolute; bottom: var(--s-4); left: 50%; transform: translateX(-50%); }
  .preview.stale :global(svg) { opacity: 0.35; }

---
import Base from "../../../layouts/Base.astro";
import Locator from "../../../components/Locator.astro";
import LineChart from "../../../components/LineChart.astro";
import ThermometerCard from "../../../components/Thermometer.astro";
import { ficha, indicators, resumo, ufs } from "../../../lib/data";
import { fmtBRL, fmtNumber, fmtPct, fmtBRLShort } from "../../../lib/format";
import { fmtValue, SOURCE_LABEL, THERMO_CLASS, THERMO_LABEL } from "../../../lib/indicators";
import type { Ficha } from "../../../lib/types";

export function getStaticPaths() {
  return ufs().flatMap((u) =>
    resumo(u.slug).municipios.map((m) => ({ params: { uf: u.slug, slug: m.slug } })),
  );
}
const { uf, slug } = Astro.params as { uf: string; slug: string };
const f: Ficha = ficha(uf, slug);
const R = resumo(uf);
const IND = indicators();
const src = R.sources;
const snisYear = R.snis_year;
const stats = R.stats;
const ref = (k: string) => (src[k]?.status === "unavailable" ? null : src[k]);
// Código SNIS de cada indicador, para a citação ficar verificável (jornalista, revisão M4)
const SNIS_CODE: Record<string, string> = { snis_agua_pct: "IN055", snis_esgoto_pct: "IN056", snis_esgoto_tratado_pct: "IN056 × IN016",
  snis_tratamento_pct: "IN046", snis_perdas_pct: "IN049", snis_consumo_lhabdia: "IN022" };
const cellSource = (k: string, s: string) => {
  if (!ref(s)) return "fonte indisponível nesta atualização";
  if (s === "snis") return `SNIS ${f.ind_ano[k] ?? f.ind_antigo?.[k]?.[1] ?? ""}, ${SNIS_CODE[k] ?? ""}`;
  return `${SOURCE_LABEL[IND[k]?.source ?? ""] ?? IND[k]?.source}, ${src[s].reference_period}`;
};
const mirrorNote = (k: string) => (src[k]?.url_kind === "mirror" ? " (cópia pública do dado oficial)" : "");
const srcLine = (k: string, label: string) => {
  const s = src[k];
  if (!s || s.status === "unavailable") return `${label}: fonte indisponível nesta atualização`;
  return `${label}, ${s.reference_period}${mirrorNote(k)}${s.status === "stale" ? " · desatualizado" : ""}`;
};
const rows = [
  ["censo_agua_rede_pct", "censo_agua"], ["censo_esgoto_adequado_pct", "censo_esgoto"], ["censo_lixo_coletado_pct", "censo_lixo"],
  ["snis_agua_pct", "snis"], ["snis_esgoto_pct", "snis"], ["snis_esgoto_tratado_pct", "snis"], ["snis_tratamento_pct", "snis"], ["snis_perdas_pct", "snis"],
  ["snis_consumo_lhabdia", "snis"], ["drsai_taxa_10mil", "sih_drsai"], ["drsai_custo_per_capita", "sih_drsai"],
] as const;
const nbVals = f.neighbors.map((n) => ({ ...n, m: R.municipios.find((x) => x.cod === n.cod)! }));
const h = f.health;
const c = f.communities;
const title = `${f.nome} (${f.uf}): água, esgoto e saúde`;
const desc = f.resumo.slice(0, 2).join(" ");
const calcUrl = `/calculadora?uf=${uf}&m=${slug}`;
const shareText = encodeURIComponent(`Seu território tem sede? Veja os dados de ${f.nome}: `);
const pageUrl = `${Astro.site?.toString().replace(/\/$/, "")}/municipio/${uf}/${slug}`;
// Fases da FUNAI em linguagem simples (o termo oficial continua visível no GeoJSON e nos downloads)
const FASE: Record<string, string> = {
  "Encaminhada RI": "encaminhada como reserva indígena", "Em Estudo": "em estudo", "Delimitada": "delimitada",
  "Declarada": "declarada", "Homologada": "homologada", "Regularizada": "regularizada",
};
const dimLabel: Record<string, string> = Object.fromEntries(Object.entries(R.index.dimensions).map(([k, v]) => [k, v.label]));
---
<Base title={title} description={desc} ogImage={`/og/${uf}/${slug}.png`}
  jsonLd={{ "@context": "https://schema.org", "@type": "Dataset", name: `Saneamento e saúde em ${f.nome}/${f.uf}`, description: desc,
    url: pageUrl, license: "https://creativecommons.org/licenses/by/4.0/", creator: { "@type": "Organization", name: "Instituto SDW" },
    spatialCoverage: { "@type": "Place", name: `${f.nome}, ${f.uf_nome}, Brasil` } }}>
  <div class="hero">
    <div class="wrap hero-in">
      <div>
        <nav aria-label="Trilha" class="crumbs small"><a href="/">Início</a> › <a href={`/mapa?uf=${uf}`}>{f.uf_nome}</a> › <span aria-current="page">{f.nome}</span></nav>
        <h1>{f.nome} <span class="uf">{f.uf}</span></h1>
        <p class="meta small">{f.regiao_intermediaria} · {fmtNumber(f.ind.populacao)} moradores {f.semiarido && <span class="tag warn">Semiárido</span>}</p>
        <div class="resumo">{f.resumo.map((p) => <p>{p}</p>)}</div>
        <ul class="key" aria-label="Principais números">
          <li><span class="kn">{fmtPct(f.ind.snis_agua_pct)}</span><span class="kl">da população atendida com água</span></li>
          <li><span class="kn">{f.ind.snis_esgoto_tratado_pct === null && f.esgoto_sem_declaracao ? "sem rede" : fmtPct(f.ind.snis_esgoto_tratado_pct)}</span><span class="kl">{f.ind.snis_esgoto_tratado_pct === null && f.esgoto_sem_declaracao ? "nenhum prestador de esgoto declarado" : "com esgoto coletado e tratado"}</span></li>
          <li><span class:list={["kn", THERMO_CLASS[f.thermometer.esgoto.status]]}>{THERMO_LABEL[f.thermometer.esgoto.status]}</span><span class="kl">na meta de esgoto de 2033</span></li>
        </ul>
        <p class="source">SNIS (Ministério das Cidades), {snisYear}{src.snis?.url_kind === "mirror" ? ", cópia pública do dado oficial" : ""}.</p>
        <div class="actions no-print">
          <a class="btn" href={calcUrl}>Calcular a economia</a>
          <a class="btn secondary" href={`/escola/${uf}/${slug}`}>Versão para a escola</a>
        </div>
      </div>
      <div class="locator"><Locator uf={uf} cod={f.cod} nome={f.nome} /></div>
    </div>
  </div>

  <div class="wrap layout">
    <nav class="toc no-print small" aria-label="Nesta página">
      <a href="#indicadores">Indicadores</a><a href="#meta2033">Meta 2033</a><a href="#saude">Saúde e custo</a>
      <a href="#comunidades">Comunidades</a><a href="#prioridade">Prioridade</a><a href="#agir">Agir</a><a href="#fontes">Fontes</a>
    </nav>

    <section id="indicadores" class="section">
      <h2>Como está o saneamento</h2>
      <div class="table-scroll card flat" tabindex="0" role="region" aria-label="Indicadores do município">
        <table class="stack">
          <caption class="visually-hidden">Indicadores de {f.nome} comparados com a mediana da {f.uf_nome} e do Brasil</caption>
          <thead><tr><th scope="col">Indicador</th><th scope="col" class="num">{f.nome}</th><th scope="col" class="num">Mediana {f.uf}</th><th scope="col" class="num">Mediana Brasil</th><th scope="col">Fonte</th></tr></thead>
          <tbody>
            {rows.filter(([, s]) => ref(s)).map(([k, s]) => {
              const d = IND[k]; const st = stats[k];
              return (
                <tr>
                  <th scope="row" data-label="Indicador">{d?.short ?? k}<br /><span class="xsmall muted">{d?.direction === "higher_is_better" ? "quanto maior, melhor" : d?.direction === "higher_is_worse" ? "quanto menor, melhor" : ""}</span></th>
                  <td class="num" data-label={f.nome}>{f.ind[k] === null && f.ind_antigo?.[k] ? <span class="nodata">desatualizado<br /><span class="xsmall">último dado: {fmtValue(d, f.ind_antigo[k][0])} em {f.ind_antigo[k][1]}</span></span> : <strong>{fmtValue(d, f.ind[k])}</strong>}{f.ind_ano[k] && f.ind_ano[k] !== snisYear && <span class="xsmall muted"><br />({f.ind_ano[k]})</span>}{k === "snis_esgoto_pct" && f.ind[k] === null && f.esgoto_sem_declaracao && <span class="xsmall muted"><br />nenhum prestador declarou</span>}</td>
                  <td class="num" data-label={`Mediana ${f.uf}`}>{fmtValue(d, st?.median_uf)}</td>
                  <td class="num" data-label="Mediana Brasil">{fmtValue(d, st?.median_br)}</td>
                  <td class="xsmall" data-label="Fonte">{cellSource(k, s)}</td>
                </tr>);
            })}
          </tbody>
        </table>
      </div>
      {rows.some(([, s]) => !ref(s)) && (
        <p class="small muted">Ainda sem dado nesta atualização (fonte indisponível): {rows.filter(([, s]) => !ref(s)).map(([k]) => IND[k]?.short ?? k).join("; ")}. <a href="/dados#fontes">Por quê?</a></p>
      )}
      {Object.entries(f.divergence).filter(([, v]) => v.flag).map(([svc, v]) => (
        <div class="callout">
          <strong>Os números de {svc === "agua" ? "água" : "esgoto"} não batem, e isso é informação.</strong>
          <p>O prestador de serviço declara {fmtPct(v.snis)} ao SNIS; o Censo, que pergunta em cada casa, encontrou {fmtPct(v.censo)}. Diferença de {fmtNumber(Math.abs(v.diff_pp), 1)} pontos. O SNIS é autodeclarado e mede quem a rede alcança; o Censo mede o que o morador usa. <a href="/faq#snis-censo">Por que isso acontece?</a></p>
        </div>
      ))}
      <div class="grid grid-2" style="margin-top:var(--s-5)">
        <div class="card">
          <LineChart title="Atendimento de água e esgoto ao longo do tempo" target={{ value: 90, label: "meta de esgoto 2033: 90%" }}
            series={[{ label: "Água", points: f.series.snis_agua_pct ?? [], color: "#0868ac" }, { label: "Esgoto coletado", points: f.series.snis_esgoto_pct ?? [], color: "#b8461d", dashed: true }, { label: "Esgoto coletado e tratado", points: f.series.snis_esgoto_tratado_pct ?? [], color: "#7a3a12" }]}
            source={srcLine("snis", "SNIS")} />
        </div>
        <div class="card">
          <h3>Vizinhos</h3>
          {nbVals.length ? (
            <div class="table-scroll" tabindex="0" role="region" aria-label="Comparação com os vizinhos"><table>
              <caption class="visually-hidden">Comparação com municípios vizinhos</caption>
              <thead><tr><th scope="col">Município</th><th scope="col" class="num">Água (SNIS)</th><th scope="col" class="num">Esgoto (SNIS)</th></tr></thead>
              <tbody>
                <tr class="self"><th scope="row">{f.nome}</th><td class="num">{fmtPct(f.ind.snis_agua_pct)}</td><td class="num">{fmtPct(f.ind.snis_esgoto_pct)}</td></tr>
                {nbVals.map((n) => <tr><th scope="row"><a href={`/municipio/${uf}/${n.slug}`}>{n.nome}</a></th><td class="num">{fmtPct(n.m.ind.snis_agua_pct)}</td><td class="num">{fmtPct(n.m.ind.snis_esgoto_pct)}</td></tr>)}
              </tbody>
            </table></div>
          ) : <p class="nodata">Sem vizinhos na mesma UF.</p>}
          <p class="source">Fonte: {srcLine("snis", "SNIS")}. Vizinhos: municípios que fazem divisa (malha IBGE 2022).</p>
        </div>
      </div>
    </section>

    <section id="meta2033" class="section">
      <h2>Termômetro 2033</h2>
      <p class="text">O Marco Legal do Saneamento (Lei 14.026/2020) definiu que, até 2033, 99% da população deve ter água potável e 90% deve ter coleta e tratamento de esgoto. Medimos a distância com os dados do SNIS e projetamos a tendência dos últimos anos.</p>
      <div class="grid grid-2">
        <div class="card"><ThermometerCard t={f.thermometer.agua} title="Água: meta de 99%" /></div>
        <div class="card"><ThermometerCard t={f.thermometer.esgoto} title="Esgoto coletado e tratado: meta de 90%" /></div>
      </div>
      <p class="source">Fonte: {srcLine("snis", "SNIS")}. Esgoto coletado e tratado = atendimento por rede coletora (IN056) × tratamento do esgoto coletado (IN016). A meta exige coleta e tratamento. <a href="/metodologia#termometro">Como calculamos</a>.</p>
    </section>

    <section id="saude" class="section">
      <h2>Saúde e o custo de não ter saneamento</h2>
      {h ? (
        <div class="grid grid-3">
          <div class="card stat"><p class="n">{fmtNumber(h.internacoes)}</p><p>internações por ano no SUS por doenças ligadas à água e ao esgoto</p></div>
          <div class="card stat"><p class="n">{fmtBRLShort(h.valor)}</p><p>pagos pelo SUS por ano nessas internações</p></div>
          <div class="card stat"><p class="n">{fmtNumber(h.taxa_10mil, 1)}</p><p>internações por 10 mil habitantes (mediana {f.uf}: {fmtNumber(stats.drsai_taxa_10mil?.median_uf, 1)})</p></div>
        </div>
      ) : (
        <div class="card pending">
          <p><strong>Os dados de internações ainda não foram processados nesta versão.</strong></p>
          <p class="small">Eles vêm do sistema de internações do SUS (SIH, DATASUS) e entram na nossa atualização mensal. Quando estiverem disponíveis, esta seção mostrará quantas pessoas são internadas por ano por doenças como diarreia, hepatite A e leptospirose, quanto isso custa ao SUS e quanto o município economizaria com saneamento.</p>
        </div>
      )}
      <p class="source">Fonte: {srcLine("sih_drsai", "DATASUS, SIH/SUS")}{h && `, ${h.period}`}. Doenças relacionadas ao saneamento ambiental inadequado (DRSAI), núcleo conservador. <a href="/metodologia#drsai">Quais doenças entram</a>.</p>
      <p><a class="btn secondary no-print" href={calcUrl}>Abrir a calculadora com os dados de {f.nome}</a></p>
    </section>

    <section id="comunidades" class="section">
      <h2>Comunidades e territórios</h2>
      <div class="grid grid-2">
        <div class="card">
          <h3>Povos e comunidades no Censo 2022</h3>
          {c.retirado_a_pedido && <p class="tag">Informações retiradas a pedido da comunidade</p>}
          <dl class="kv">
            <dt>Pessoas quilombolas</dt>
            <dd>{c.pop_quilombola === null ? <span class="nodata">sem dado</span> : c.pop_quilombola_lower_bound ? <>pelo menos <strong>{fmtNumber(c.pop_quilombola)}</strong></> : <strong>{fmtNumber(c.pop_quilombola)}</strong>}</dd>
            {c.pop_indigena != null ? (<><dt>Pessoas indígenas</dt><dd><strong>{fmtNumber(c.pop_indigena)}</strong></dd></>) : (<>
            <dt>Pessoas de cor ou raça indígena <span class="xsmall muted">(o total oficial de pessoas indígenas, que inclui quem se considera indígena, ainda não está integrado)</span></dt>
            <dd>{c.pop_cor_indigena === null ? <span class="nodata">sem dado</span> : <strong>{fmtNumber(c.pop_cor_indigena)}</strong>}</dd></>)}
          </dl>
          {c.pop_quilombola_lower_bound && c.pop_quilombola !== null && <p class="xsmall muted">“Pelo menos”: a cópia pública usada soma faixas de idade e sexo, e o IBGE oculta faixas muito pequenas para proteger a privacidade ({fmtNumber(c.quilombola_pct_celulas_sigilo)}% das faixas deste município estão sob sigilo). O total oficial pode ser maior.</p>}
          {c.pop_quilombola === null && <p class="xsmall muted">“Sem dado”: todas as faixas de idade e sexo deste município estão sob sigilo na cópia pública usada, ou não há pessoas quilombolas recenseadas. Não é possível distinguir os dois casos.</p>}
          {c.pop_quilombola_em_territorio !== null && c.pop_quilombola_em_territorio > 0 && <p class="xsmall muted">Pelo menos {fmtNumber(c.pop_quilombola_em_territorio)} vivem em territórios quilombolas delimitados pelo IBGE.</p>}
          {c.pop_quilombola_lower_bound && (c.quilombola_pct_celulas_sigilo ?? 0) > 50 && c.pop_quilombola !== null && <p class="tag warn">Dado parcial: {fmtNumber(c.quilombola_pct_celulas_sigilo)}% das faixas sob sigilo do IBGE</p>}
          <p class="xsmall muted">O status oficial de titulação (INCRA) e de certificação (Fundação Palmares) ainda não está integrado à plataforma.</p>
          <p class="source">Fonte: {srcLine("censo_quilombola", "IBGE, Censo 2022")}.</p>
        </div>
        <div class="card">
          <h3>Terras indígenas</h3>
          {c.terras_indigenas.length ? (
            <ul class="tis">{c.terras_indigenas.map((t) => <li><strong>{t.modalidade === "Reserva Indígena" ? "Reserva Indígena" : "Terra Indígena"} {t.nome}</strong>{t.ufs && t.ufs !== f.uf && <span class="small"> ({t.ufs})</span>}<br /><span class="small">Situação oficial: <strong>{FASE[t.fase ?? ""] ?? t.fase ?? "não informada"}</strong>{t.fase && ["Em Estudo", "Delimitada", "Declarada"].includes(t.fase) && " (demarcação em andamento; pode ser revisão dos limites de outra terra da lista)"}{t.modalidade && t.modalidade !== "Reserva Indígena" && ` · ${t.modalidade}`}. {t.etnia && `Povos: ${t.etnia}.`}{t.data_ref && ` Dados de ${t.data_ref.slice(6, 8)}/${t.data_ref.slice(4, 6)}/${t.data_ref.slice(0, 4)}.`}</span></li>)}</ul>
          ) : <p class="muted">Nenhuma terra indígena com área relevante dentro do município, segundo a FUNAI.</p>}
          {c.ucs_uso_sustentavel && c.ucs_uso_sustentavel.length > 0 && (
            <>
              <h3 class="sub">Reservas extrativistas e de desenvolvimento sustentável</h3>
              <ul class="tis">{c.ucs_uso_sustentavel.map((u) => <li><strong>{u.nome}</strong><br /><span class="small">{u.categoria} ({u.esfera.toLowerCase()}){u.ano_criacao && `, criada em ${u.ano_criacao}`}. Unidades onde vivem e trabalham populações tradicionais extrativistas.</span></li>)}</ul>
              <p class="source">Fonte: Cadastro Nacional de Unidades de Conservação (MMA), via geobr/Ipea.</p>
            </>
          )}
          <p class="source">Fonte: {c.fonte_tis}. Mostramos só o território oficial, nunca a localização de aldeias. <a href="/povos-e-comunidades">Nossos princípios e como pedir correção ou retirada</a>.</p>
        </div>
      </div>
    </section>

    <section id="prioridade" class="section">
      <h2>Posição no índice de prioridade</h2>
      {f.index.score !== null ? (
        <p class="text">{f.nome} está em <strong>{f.index.rank}º lugar</strong> entre {f.index.n_ranked} municípios da {f.uf_nome} (1º = maior prioridade), com nota {fmtNumber(f.index.score)} de 100.</p>
      ) : (
        <p class="text">O índice ainda não pôde ser calculado para a {f.uf_nome}: ele precisa de pelo menos {R.index.min_dimensions_for_rank} das 5 dimensões, e nesta atualização há dados para {R.index.dims_available.length} ({R.index.dims_available.map((d) => dimLabel[d]).join(", ")}). Faltam: {R.index.dims_missing.map((d) => dimLabel[d]).join(", ")}.</p>
      )}
      <div class="dims">
        {Object.entries(f.index.dims).map(([d, v]) => (
          <div class="dim"><span class="small">{dimLabel[d]}</span><div class="dbar" role="img" aria-label={`${dimLabel[d]}: ${v === null ? "sem dado" : fmtNumber(v) + " de 100"}`}>{v !== null && <div style={`width:${v}%`}></div>}</div><span class="small num">{v === null ? "sem dado" : fmtNumber(v)}</span></div>
        ))}
      </div>
      <p class="xsmall muted">Cada barra vai de 0 a 100 e compara o município com os outros do estado: 0 é a melhor situação e 100, a pior. <a href="/indice">Ajuste os pesos e veja o ranking</a>.</p>
    </section>

    <section id="agir" class="section">
      <h2>Agir: soluções que combinam com este território</h2>
      <div class="grid grid-2">
        {f.suggestions.map((s) => (<div class="card"><h3>{s.title}</h3><p class="small">{s.why}</p></div>))}
      </div>
      <p class="small">Quer levar uma dessas soluções para {f.nome}? Fale com o Instituto SDW: <a href={`mailto:${f.suggestions[0]?.contact}`}>{f.suggestions[0]?.contact}</a>. As sugestões seguem regras simples e públicas, descritas na <a href="/metodologia#agir">metodologia</a>.</p>
    </section>

    <section id="fontes" class="section">
      <h2>Fontes, dados e compartilhamento</h2>
      <details class="small"><summary>Situação de cada base de dados nesta atualização</summary><ul>
        {Object.entries(src).map(([k, s]) => (<li><strong>{s.name ?? k}</strong>: {s.status === "unavailable" ? "indisponível nesta atualização" : `${s.reference_period}${s.url_kind === "mirror" ? ", via cópia pública rastreável" : ""}${s.status === "stale" ? " (desatualizado)" : ""}`}</li>))}
      </ul></details>
      <div class="actions no-print">
        <a class="btn secondary" href={`/data/${uf}/dados/municipios/${slug}.csv`} download>Baixar dados (CSV)</a>
        <a class="btn secondary" href={`/data/${uf}/municipios/${slug}.json`} download>Baixar dados (JSON)</a>
        <a class="btn secondary" href={`https://wa.me/?text=${shareText}${encodeURIComponent(pageUrl)}`}>Compartilhar no WhatsApp</a>
        <a class="btn secondary" href={`/og/${uf}/${slug}.png`}>Card para redes sociais</a>
      </div>
      <p class="xsmall muted">Gerado em {new Date(f.generated_at).toLocaleDateString("pt-BR")}. Viu algo errado? <a href="/sobre#corrigir">Corrija um dado</a>.</p>
    </section>
  </div>
</Base>
<style>
  .hero { background: linear-gradient(180deg, var(--c-water-100), var(--c-sand-50)); padding: var(--s-6) 0 var(--s-5); }
  .hero-in { display: grid; gap: var(--s-5); align-items: center; }
  @media (min-width: 860px) { .hero-in { grid-template-columns: 3fr 2fr; } }
  .crumbs { margin-bottom: var(--s-2); }
  .uf { font-size: 0.5em; color: var(--c-ink-muted); font-weight: 600; }
  .resumo p { font-size: var(--fs-lg); max-width: 40rem; margin-bottom: var(--s-3); }
  .actions { display: flex; gap: var(--s-2); flex-wrap: wrap; margin-top: var(--s-4); }
  .locator { max-width: 320px; justify-self: center; width: 100%; }
  .toc { display: flex; gap: var(--s-3); overflow-x: auto; padding: var(--s-3) 0; border-bottom: 1px solid var(--c-line); position: sticky; top: 60px; background: var(--c-sand-50); z-index: 5; white-space: nowrap; }
  @media (max-width: 979px) { .toc { top: 0; } }

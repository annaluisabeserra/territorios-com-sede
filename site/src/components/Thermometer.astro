---
import { fmtPct, fmtNumber } from "../lib/format";
import { THERMO_CLASS, THERMO_LABEL } from "../lib/indicators";
import type { Thermometer } from "../lib/types";

interface Props { t: Thermometer; title: string }
const { t, title } = Astro.props;
const cur = t.current ?? 0;
const plausible = (y: number | null) => y !== null && y <= 2100;
const statusText: Record<string, string> = {
  atingida: t.uncertain ? "A meta foi alcançada no último ano informado; falta confirmar nos próximos anos." : "A meta já foi alcançada.",
  no_ritmo: t.projected_year ? `Mantido o ritmo, a meta seria alcançada por volta de ${t.projected_year}.` : "",
  atrasado: plausible(t.projected_year) ? `No ritmo atual, a meta só seria alcançada por volta de ${t.projected_year}, depois de 2033.` : "No ritmo atual, a meta não seria alcançada: o indicador está parado, caindo ou subindo devagar demais.",
  sem_dados: t.reason ? `Não dá para projetar: ${t.reason}.` : "O município não informou este dado ao SNIS.",
};
const range = t.status !== "atingida" && t.status !== "sem_dados" && (t.slope ?? 0) > 0 && plausible(t.projected_year) ? (
  t.projected_year_low && plausible(t.projected_year_high) ? `Faixa da tendência: ${t.projected_year_low} a ${t.projected_year_high}.`
  : t.projected_year_low ? `Faixa da tendência: a partir de ${t.projected_year_low}; no cenário mais lento, a meta não é alcançada.` : ""
) : "";
---
<div class="thermo">
  <div class="head">
    <h3>{title}</h3>
    <span class:list={["tag", THERMO_CLASS[t.status]]}>{THERMO_LABEL[t.status]}{t.uncertain && " (projeção incerta)"}</span>
  </div>
  <div class="bar" role="img" aria-label={`${title}: ${t.current !== null ? `${fmtPct(t.current)} em ${t.current_year}` : "sem dado"}, meta de ${fmtNumber(t.target)}%`}>
    <div class="fill" style={`width:${Math.min(100, cur)}%`}></div>
    <div class="target" style={`left:${t.target}%`}><span>meta {fmtNumber(t.target)}%</span></div>
  </div>
  <p class="big">{t.current !== null ? fmtPct(t.current) : <span class="nodata">sem dado</span>} {t.current_year && <span class="small muted">em {t.current_year}{t.status === "sem_dados" && t.reason.startsWith("último") ? " (desatualizado)" : ""}</span>}</p>
  {t.gap !== null && t.gap > 0 && <p class="small">Faltam <strong>{fmtNumber(t.gap, 1)} pontos percentuais</strong> até a meta.</p>}
  <p class="small">{statusText[t.status]} {range}</p>
  {t.uncertain && <p class="xsmall"><strong>Projeção incerta:</strong> os dados oscilam muito, e a tendência pode ser de estagnação.</p>}
  {t.slope !== null && <p class="xsmall muted">Tendência: {t.slope >= 0 ? "+" : ""}{fmtNumber(t.slope, 1)} {Math.abs(t.slope) >= 0.95 && Math.abs(t.slope) < 1.05 ? "ponto percentual" : "pontos percentuais"} por ano, calculada com os dados de {t.years[0]} a {t.years[t.years.length - 1]}. É uma projeção simples, só para orientar.</p>}
</div>
<style>
  .thermo { display: grid; gap: var(--s-2); }
  .head { display: flex; justify-content: space-between; align-items: center; gap: var(--s-2); flex-wrap: wrap; }
  .head h3 { margin: 0; }
  .bar { position: relative; height: 18px; background: var(--c-sand-100); border-radius: 999px; margin: var(--s-5) 0 var(--s-2); }
  .fill { height: 100%; background: linear-gradient(90deg, var(--c-water-500), var(--c-water-700)); border-radius: 999px; }
  .target { position: absolute; top: -8px; bottom: -8px; width: 3px; background: var(--c-alert); }
  .target span { position: absolute; bottom: 100%; transform: translateX(-50%); white-space: nowrap; font-size: var(--fs-xs); font-weight: 700; color: var(--c-alert); }
  .big { font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 750; margin: 0; }
  p { margin: 0; }
</style>
